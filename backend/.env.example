POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-characters
DEMO_DATA=false
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
# LLM: fill in the team key; auto selects a model for each task. Do not commit backend/.env.
# Organizer gateway is configured automatically; ALFA_API_KEY is also supported.
LLM_API_KEY=
LLM_MODEL_ID=auto
# Set an explicit ID below to use one model for every request:
# qwen/qwen3.6-35b-a3b
# google/gemma-4-26b-a4b-it
# z-ai/glm-5.3-flash
# deepseek/deepseek-v4.1-flash
# qwen/qwen3-vl-30b-a3b-instruct
# moonshotai/kimi-k2.6
# The organizer gateway enforces the shared monetary limit. Local defaults:
# 100 model calls/day, 250000 conservatively reserved tokens/day (Moscow time).
API_PORT=8000
