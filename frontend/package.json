{
  "name": "alfa-business-pulse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server.mjs",
    "check": "vite build && node --check src/lib/api.js && node --check src/lib/models.js && node --check server.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.0"
  }
}
